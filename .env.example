# Production runtime configuration
NODE_ENV=production
DB_HOST=postgres.example.internal
DB_PORT=5432
DB_USER=notification_app
DB_PASSWORD=replace-with-a-secret
DB_NAME=notification_production

REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_DB=0

INTERNAL_API_KEY=replace-with-a-long-random-secret
PORT=3000

# Production email provider configuration
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=notifications@example.com
EMAIL_PROVIDER_TIMEOUT_MS=3000

# Optional local Docker Compose overrides. Put actual local values in the
# ignored .env file; these are not production credentials.
COMPOSE_DB_USER=notification_app
COMPOSE_DB_PASSWORD=replace-with-a-local-compose-password
COMPOSE_DB_NAME=notification_production
COMPOSE_INTERNAL_API_KEY=replace-with-a-local-compose-internal-key
