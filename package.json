{
  "name": "bullmq-notification-system",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/workers/run-email-worker.ts",
    "events": "tsx watch src/events/run-email-events.ts",
    "relay": "tsx watch src/workers/run-outbox-relay.ts",
    "migrate": "tsx src/db/run-migrations.ts",
    "start": "tsx dist/server.js",
    "build": "tsc",
    "test": "vitest run --no-file-parallelism --maxWorkers=1",
    "test:watch": "vitest --no-file-parallelism --maxWorkers=1",
    "test:integration": "vitest run tests/integration --no-file-parallelism --maxWorkers=1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bullmq": "^6.3.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}